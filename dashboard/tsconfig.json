  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true, "types": ["vite/client", "node"],
    "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
